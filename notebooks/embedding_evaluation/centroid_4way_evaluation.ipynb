{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 4-Centroid Nearest-Centroid Evaluation\n",
    "## bge-large-en-v1.5 Embeddings on 10,000 Stratified Samples\n",
    "\n",
    "**Protocol:** 10,000 stratified samples → 80/20 split (8,000 train / 2,000 test)\n",
    "**Method:** Compute 4 category centroids (benign\_control, jailbreak, direct\_injection, system\_prompt\_extraction) from training embeddings. Classify each test sample by argmax cosine similarity to centroids.\n",
    "**Runtime:** Enable GPU P100 in Kaggle Settings → Accelerator → GPU P100"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q sentence-transformers scikit-learn pandas numpy matplotlib seaborn\n",
    "\n",
    "import torch\n",
    "print(f\"PyTorch version: {torch.__version__}\")\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")\n",
    "\n",
    "CUDA_WORKS = False\n",
    "if torch.cuda.is_available():\n",
    "    try:\n",
    "        _t = torch.randn(10).cuda()\n",
    "        _t = _t * 2\n",
    "        del _t\n",
    "        torch.cuda.empty_cache()\n",
    "        CUDA_WORKS = True\n",
    "        print(\"CUDA kernel test: PASSED\")\n",
    "    except Exception as e:\n",
    "        print(f\"CUDA kernel test: FAILED ({e})\")\n",
    "else:\n",
    "    print(\"No GPU detected.\")\n",
    "\n",
    "DEVICE = \"cuda\" if CUDA_WORKS else \"cpu\"\n",
    "print(f\"Using device: {DEVICE}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, balanced_accuracy_score, f1_score, roc_auc_score,\n",
    "    precision_score, recall_score, confusion_matrix, roc_curve\n",
    ")\n",
    "from sentence_transformers import SentenceTransformer\n",
    "\n",
    "sns.set_style(\"whitegrid\")\n",
    "plt.rcParams[\"figure.dpi\"] = 150\n",
    "\n",
    "OUTPUT_DIR = \"/kaggle/working\"\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_PATH = \"/kaggle/input/datasets/prashannadeveloper/guardrailer-dataset-v1/guardrailer_dataset_v1.parquet\"\n",
    "\n",
    "df = pd.read_parquet(DATA_PATH)\n",
    "df[\"text\"] = df[\"prompt_text\"]\n",
    "df[\"label\"] = df[\"is_malicious\"].astype(int)\n",
    "\n",
    "print(f\"Total samples: {len(df)}\")\n",
    "print(f\"\\nLabel distribution:\")\n",
    "print(df[\"label\"].value_counts())\n",
    "print(f\"\\nAttack category distribution:\")\n",
    "print(df[\"attack_category\"].value_counts())\n",
    "print(f\"\\nCategories: {df['attack_category'].unique().tolist()}\")\n",
    "\n",
    "# Stratified 10,000 sample subset\n",
    "subset, _ = train_test_split(df, train_size=10000, random_state=42, stratify=df[\"label\"])\n",
    "\n",
    "# 80/20 train/test split\n",
    "sub_train, sub_test = train_test_split(subset, test_size=0.20, random_state=42, stratify=subset[\"label\"])\n",
    "\n",
    "print(f\"\\nSubset: {len(subset)} samples\")\n",
    "print(f\"Train: {len(sub_train)}  Test: {len(sub_test)}\")\n",
    "print(f\"Train dist: safe={sum(sub_train['label']==0)}, malicious={sum(sub_train['label']==1)}\")\n",
    "print(f\"Test dist:  safe={sum(sub_test['label']==0)}, malicious={sum(sub_test['label']==1)}\")\n",
    "print(f\"\\nTrain attack categories:\")\n",
    "print(sub_train[\"attack_category\"].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Encode with bge-large-en-v1.5\n",
    "MODEL_NAME = \"BAAI/bge-large-en-v1.5\"\n",
    "model = SentenceTransformer(MODEL_NAME)\n",
    "print(f\"Model loaded: {MODEL_NAME}\")\n",
    "\n",
    "start = time.time()\n",
    "print(f\"Encoding train set ({len(sub_train)} samples)...\")\n",
    "train_emb = model.encode(\n",
    "    sub_train[\"text\"].astype(str).tolist(),\n",
    "    batch_size=128, show_progress_bar=True,\n",
    "    normalize_embeddings=True, device=DEVICE\n",
    ")\n",
    "train_emb = np.array(train_emb)\n",
    "train_labels = sub_train[\"label\"].values\n",
    "train_categories = sub_train[\"attack_category\"].values\n",
    "\n",
    "print(f\"Encoding test set ({len(sub_test)} samples)...\")\n",
    "test_emb = model.encode(\n",
    "    sub_test[\"text\"].astype(str).tolist(),\n",
    "    batch_size=128, show_progress_bar=True,\n",
    "    normalize_embeddings=True, device=DEVICE\n",
    ")\n",
    "test_emb = np.array(test_emb)\n",
    "test_labels = sub_test[\"label\"].values\n",
    "test_categories = sub_test[\"attack_category\"].values\n",
    "\n",
    "encode_time = time.time() - start\n",
    "print(f\"Encoding time: {encode_time:.1f}s\")\n",
    "\n",
    "del model\n",
    "if torch.cuda.is_available():\n",
    "    torch.cuda.empty_cache()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute 4 category centroids from training data\n",
    "unique_cats = np.unique(train_categories)\n",
    "print(f\"Computing {len(unique_cats)} centroids from training data...\")\n",
    "\n",
    "centroids = {}\n",
    "centroid_normed_list = []\n",
    "centroid_labels = []\n",
    "\n",
    "for cat in unique_cats:\n",
    "    mask = train_categories == cat\n",
    "    mean_emb = train_emb[mask].mean(axis=0)\n",
    "    norm = np.linalg.norm(mean_emb)\n",
    "    normed = mean_emb / norm if norm > 1e-8 else mean_emb\n",
    "    centroids[cat] = normed\n",
    "    centroid_normed_list.append(normed)\n",
    "    centroid_labels.append(cat)\n",
    "    print(f\"  {cat}: {mask.sum()} samples, centroid norm={norm:.4f}\")\n",
    "\n",
    "centroid_matrix = np.array(centroid_normed_list)  # (4, 1024)\n",
    "\n",
    "# Compute inter-centroid cosine similarity\n",
    "C = centroid_matrix @ centroid_matrix.T\n",
    "print(f\"\\nInter-centroid cosine similarity matrix:\")\n",
    "for i, cat_i in enumerate(centroid_labels):\n",
    "    for j, cat_j in enumerate(centroid_labels):\n",
    "        if j > i:\n",
    "            print(f\"  {cat_i} <-> {cat_j}: {C[i,j]:.6f}\")\n",
    "\n",
    "avg_C = (C.sum() - np.trace(C)) / (len(unique_cats) * (len(unique_cats) - 1))\n",
    "print(f\"  Mean off-diagonal C: {avg_C:.6f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Classify test samples: argmax cosine similarity to 4 centroids\n",
    "# Each test embedding is normalized, then dot product with all 4 centroids\n",
    "q_norms = np.linalg.norm(test_emb, axis=1, keepdims=True)\n",
    "q_norms = np.maximum(q_norms, 1e-8)\n",
    "test_normed = test_emb / q_norms\n",
    "\n",
    "centroid_scores = test_normed @ centroid_matrix.T  # (n_test, 4)\n",
    "pred_cat_idx = np.argmax(centroid_scores, axis=1)  # predicted category index\n",
    "pred_categories = np.array([centroid_labels[i] for i in pred_cat_idx])\n",
    "max_scores = np.max(centroid_scores, axis=1)\n",
    "\n",
    "# Convert 4-class predictions to binary:\n",
    "# benign_control -> 0, everything else -> 1\n",
    "pred_labels = (pred_categories != \"benign_control\").astype(int)\n",
    "\n",
    "print(f\"Prediction distribution (4-class):\")\n",
    "for cat in unique_cats:\n",
    "    print(f\"  {cat}: {(pred_categories == cat).sum()}\")\n",
    "\n",
    "print(f\"\\nPrediction distribution (binary):\")\n",
    "print(f\"  safe (0): {(pred_labels == 0).sum()}\")\n",
    "print(f\"  malicious (1): {(pred_labels == 1).sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate as binary classification\n",
    "acc = accuracy_score(test_labels, pred_labels)\n",
    "ba = balanced_accuracy_score(test_labels, pred_labels)\n",
    "f1 = f1_score(test_labels, pred_labels, zero_division=0)\n",
    "prec = precision_score(test_labels, pred_labels, zero_division=0)\n",
    "rec = recall_score(test_labels, pred_labels, zero_division=0)\n",
    "\n",
    "# For AUC: use max centroid score for any malicious category vs benign\n",
    "# Score = max similarity to any of the 3 malicious centroids\n",
    "mal_idx = [i for i, c in enumerate(centroid_labels) if c != \"benign_control\"]\n",
    "malicious_scores = np.max(centroid_scores[:, mal_idx], axis=1)\n",
    "benign_scores = centroid_scores[:, centroid_labels.index(\"benign_control\")]\n",
    "# AUC score: use the malicious-centroid similarity as the \"probability\"\n",
    "auc = roc_auc_score(test_labels, malicious_scores)\n",
    "\n",
    "cm = confusion_matrix(test_labels, pred_labels)\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "print(f\"=\"*60)\n",
    "print(f\"4-CENTROID NEAREST-CENTROID RESULTS (Binary)\")\n",
    "print(f\"=\"*60)\n",
    "print(f\"  Accuracy:           {acc:.4f} ({acc*100:.1f}%)\")\n",
    "print(f\"  Balanced Accuracy:  {ba:.4f} ({ba*100:.1f}%)\")\n",
    "print(f\"  F1-Score:           {f1:.4f}\")\n",
    "print(f\"  Precision:          {prec:.4f}\")\n",
    "print(f\"  Recall:             {rec:.4f}\")\n",
    "print(f\"  AUC-ROC:            {auc:.4f}\")\n",
    "print(f\"\")\n",
    "print(f\"  Confusion Matrix:\")\n",
    "print(f\"    TN={tn:>6,}  FP={fp:>6,}\")\n",
    "print(f\"    FN={fn:>6,}  TP={tp:>6,}\")\n",
    "print(f\"\")\n",
    "print(f\"  Centroid C (mean off-diagonal): {avg_C:.6f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Per-category breakdown\n",
    "print(f\"Per-category accuracy:\")\n",
    "for cat in unique_cats:\n",
    "    mask = test_categories == cat\n",
    "    cat_pred = pred_categories[mask]\n",
    "    cat_acc = (cat_pred == cat).sum() / mask.sum() if mask.sum() > 0 else 0\n",
    "    print(f\"  {cat:35s}: {cat_acc:.4f} (n={mask.sum():,})\")\n",
    "\n",
    "print(f\"\\nPer-category prediction distribution:\")\n",
    "for cat in unique_cats:\n",
    "    mask = test_categories == cat\n",
    "    preds_here = pred_categories[mask]\n",
    "    print(f\"  True: {cat}\")\n",
    "    for pred_cat in unique_cats:\n",
    "        cnt = (preds_here == pred_cat).sum()\n",
    "        print(f\"    -> {pred_cat}: {cnt}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save results\n",
    "results = {\n",
    "    \"method\": \"4-centroid nearest-centroid\",\n",
    "    \"model\": \"BAAI/bge-large-en-v1.5\",\n",
    "    \"n_samples\": 10000,\n",
    "    \"split\": \"80/20\",\n",
    "    \"n_test\": len(test_labels),\n",
    "    \"accuracy\": float(acc),\n",
    "    \"balanced_accuracy\": float(ba),\n",
    "    \"f1\": float(f1),\n",
    "    \"precision\": float(prec),\n",
    "    \"recall\": float(rec),\n",
    "    \"auc_roc\": float(auc),\n",
    "    \"confusion_matrix\": {\"TN\": int(tn), \"FP\": int(fp), \"FN\": int(fn), \"TP\": int(tp)},\n",
    "    \"centroid_cosine_similarity_mean\": float(avg_C),\n",
    "    \"n_centroids\": len(unique_cats),\n",
    "    \"centroid_labels\": centroid_labels,\n",
    "    \"encode_time_sec\": float(encode_time),\n",
    "}\n",
    "\n",
    "with open(OUTPUT_DIR + \"centroid_4way_results.json\", \"w\") as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "print(\"Saved: centroid_4way_results.json\")\n",
    "print(json.dumps(results, indent=2))"
   ]
  }
